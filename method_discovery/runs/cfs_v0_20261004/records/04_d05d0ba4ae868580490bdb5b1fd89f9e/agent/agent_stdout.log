+// Dump returns a diagnostic string representation of the Framer's current state.
+// It includes information about the last frame read, read/write buffer state,
+// and configuration settings. This is useful for debugging and troubleshooting.
+func (fr *Framer) Dump() string {
+	var sb strings.Builder
+	sb.WriteString("Framer State:\n")
+	sb.WriteString(fmt.Sprintf("  MaxReadSize: %d\n", fr.maxReadSize))
+	sb.WriteString(fmt.Sprintf("  MaxHeaderListSize: %d\n", fr.maxHeaderListSize()))
+	sb.WriteString(fmt.Sprintf("  AllowIllegalWrites: %v\n", fr.AllowIllegalWrites))
+	sb.WriteString(fmt.Sprintf("  AllowIllegalReads: %v\n", fr.AllowIllegalReads))
+	
+	if fr.lastFrame != nil {
+		sb.WriteString(fmt.Sprintf("  LastFrame: %s (StreamID: %d)\n", 
+			fr.lastFrame.Header().Type, fr.lastFrame.Header().StreamID))
+	} else {
+		sb.WriteString("  LastFrame: none\n")
+	}
+	
+	if fr.lastHeaderStream != 0 {
+		sb.WriteString(fmt.Sprintf("  LastHeaderStream: %d (incomplete HEADERS/CONTINUATION)\n", 
+			fr.lastHeaderStream))
+	}
+	
+	if fr.errDetail != nil {
+		sb.WriteString(fmt.Sprintf("  ErrorDetail: %v\n", fr.errDetail))
+	}
+	
+	sb.WriteString(fmt.Sprintf("  WriteBufferLen: %d\n", len(fr.wbuf)))
+	
+	return sb.String()
+}
