+// Dump returns diagnostic information about the connection pool state.
+// It provides visibility into pool size, active connections per address,
+// and transport states for debugging and monitoring purposes.
+func (p *connPool) Dump() map[string]interface{} {
+	result := make(map[string]interface{})
+	result["pool_size"] = p.size
+	result["remote_service"] = p.remoteService
+	result["short_conn"] = p.connOpts.ShortConn
+	
+	connections := make(map[string]interface{})
+	p.conns.Range(func(addr, trans interface{}) bool {
+		address := addr.(string)
+		t := trans.(*transports)
+		
+		connInfo := make(map[string]interface{})
+		connInfo["pool_size"] = t.size
+		connInfo["round_robin_index"] = atomic.LoadUint32(&t.index)
+		
+		transports := make([]map[string]interface{}, 0, t.size)
+		for i := 0; i < int(t.size); i++ {
+			if cliTrans := t.cliTransports[i]; cliTrans != nil {
+				transInfo := make(map[string]interface{})
+				transInfo["slot"] = i
+				
+				if isActive, ok := cliTrans.(grpc.IsActive); ok {
+					transInfo["is_active"] = isActive.IsActive()
+				} else {
+					transInfo["is_active"] = "unknown"
+				}
+				
+				if remoteAddr := cliTrans.RemoteAddr(); remoteAddr != nil {
+					transInfo["remote_addr"] = remoteAddr.String()
+				}
+				if localAddr := cliTrans.LocalAddr(); localAddr != nil {
+					transInfo["local_addr"] = localAddr.String()
+				}
+				
+				transports = append(transports, transInfo)
+			}
+		}
+		connInfo["transports"] = transports
+		connInfo["active_count"] = len(transports)
+		
+		connections[address] = connInfo
+		return true
+	})
+	result["connections"] = connections
+	result["total_addresses"] = len(connections)
+	
+	return result
+}
+
