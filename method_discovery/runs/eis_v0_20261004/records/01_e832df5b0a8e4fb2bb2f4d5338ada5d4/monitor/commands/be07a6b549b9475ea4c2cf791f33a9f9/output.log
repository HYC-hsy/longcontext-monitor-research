=== driver/desktop/app.go contents ===
package desktop

import "fyne.io/fyne/v2"

// App represents a desktop application with extended system integration capabilities.
//
// Since: 2.5
type App interface {
	// SetSystemTrayMenu sets the menu that appears when interacting with the system tray icon.
	// This allows applications to provide quick access to common actions from the system tray.
	SetSystemTrayMenu(menu *fyne.Menu)

	// SystemTrayMenu returns the menu currently set for the system tray icon, or nil if none is set.
	SystemTrayMenu() *fyne.Menu
}
