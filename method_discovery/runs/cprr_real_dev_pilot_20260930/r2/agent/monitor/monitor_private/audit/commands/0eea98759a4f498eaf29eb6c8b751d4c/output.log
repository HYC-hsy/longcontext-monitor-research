// Package desktop provides desktop-specific driver features
package desktop

import "fyne.io/fyne/v2"

// App interface extends fyne.App with desktop-specific functionality.
// This includes system tray/notification area support.
//
// Since: 2.5
type App interface {
	fyne.App

	// SetSystemTrayMenu sets the menu to be displayed when the system tray icon is right-clicked.
	// This is typically used for applications that run in the background.
	SetSystemTrayMenu(menu *fyne.Menu)

	// SetSystemTrayIcon sets the icon to be displayed in the system tray/notification area.
	// This allows applications to have a custom presence in the system tray.
	SetSystemTrayIcon(icon fyne.Resource)
}
Build exit code: 0
