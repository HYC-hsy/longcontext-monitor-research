// Package transport provides predefined transport protocol.
package transport

// Protocol indicates the transport protocol.
type Protocol int

// Predefined transport protocols.
const (
	PurePayload Protocol = 0

	TTHeader Protocol = 1 << iota
	Framed
	HTTP
	GRPC
	HESSIAN2
	_STREAMING_DEPRECATED // deprecated, do not use

	TTHeaderFramed = TTHeader | Framed

	// Reorganized streaming protocol constants
	TTHeaderStreaming Protocol = 64
	GRPCStreaming     Protocol = 128
)

// Unknown indicates the protocol is unknown.
const Unknown = "Unknown"

// String prints human readable protocol name.
// For individual flags: returns the flag name.
// For composite values: returns pipe-separated flags in ascending bit order.
// Example: TTHeaderFramed.String() → "TTHeader|Framed"
func (tp Protocol) String() string {
	// Zero value
	if tp == 0 {
		return "PurePayload"
	}

	// Known non-composite values
	switch tp {
	case TTHeader:
		return "TTHeader"
	case Framed:
		return "Framed"
	case HTTP:
		return "HTTP"
	case GRPC:
		return "GRPC"
	case HESSIAN2:
		return "Hessian2"
	case TTHeaderStreaming:
		return "TTHeaderStreaming"
	case GRPCStreaming:
		return "GRPCStreaming"
	}

	// Decompose composite values into individual flags
	var parts []string
	if tp&TTHeader != 0 {
		parts = append(parts, "TTHeader")
	}
	if tp&Framed != 0 {
		parts = append(parts, "Framed")
	}
	if tp&HTTP != 0 {
		parts = append(parts, "HTTP")
	}
	if tp&GRPC != 0 {
		parts = append(parts, "GRPC")
	}
	if tp&HESSIAN2 != 0 {
		parts = append(parts, "Hessian2")
	}

	if len(parts) > 0 {
		result := parts[0]
		for i := 1; i < len(parts); i++ {
			result += "|" + parts[i]
		}
		return result
	}

	return Unknown
}
