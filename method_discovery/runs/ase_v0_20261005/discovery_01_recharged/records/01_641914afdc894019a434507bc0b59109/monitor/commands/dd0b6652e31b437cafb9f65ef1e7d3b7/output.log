=== INTERNAL/CLIENT STREAMX STRUCTURE ===
type StreamXOptions struct {
	RecvTimeout      time.Duration
	StreamMWs        []cep.StreamMiddleware
	StreamMWBs       []cep.StreamMiddlewareBuilder
	StreamRecvMWs    []cep.StreamRecvMiddleware
	StreamRecvMWBs   []cep.StreamRecvMiddlewareBuilder
	StreamSendMWs    []cep.StreamSendMiddleware
	StreamSendMWBs   []cep.StreamSendMiddlewareBuilder
}

// UnaryOption is a function that configures unary RPC call-specific settings.
// UnaryOptions are applied only to non-streaming unary RPC calls.
type UnaryOption func(o *Options)

// StreamOption is a function that configures bidirectional streaming RPC settings.
// StreamOptions are applied only to streaming RPC calls.
