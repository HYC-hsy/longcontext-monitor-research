// Package desktop provides desktop-specific driver extensions
package desktop

import "fyne.io/fyne/v2"

// App is an extended interface for desktop applications that provides platform-specific functionality
// beyond the standard fyne.App interface. This allows desktop applications to access features
// like system tray menus and system-wide notifications.
//
// Since: 2.2
type App interface {
	fyne.App

	// SetSystemTrayMenu sets a menu to be displayed when the system tray icon is right-clicked.
	// Not all desktop platforms support system tray functionality.
	SetSystemTrayMenu(menu *fyne.Menu)

	// SetSystemTrayIcon sets the icon to be displayed in the system tray.
	// Not all desktop platforms support system tray functionality.
	SetSystemTrayIcon(icon fyne.Resource)
}
