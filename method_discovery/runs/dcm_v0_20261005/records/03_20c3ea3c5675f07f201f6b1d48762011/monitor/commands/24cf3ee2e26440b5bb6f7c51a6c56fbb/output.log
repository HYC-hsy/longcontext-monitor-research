eaming = 128 // dedicated power-of-2 flag

	TTHeaderFramed = TTHeader | Framed
)

const Unknown = "Unknown"

// String prints human-readable protocol.
func (tp Protocol) String() string {
	if tp == PurePayload {
		return "PurePayload"
	}
	if tp == TTHeaderFramed {
		return "TTHeaderFramed"
	}

	var flags []string
	flagMap := []struct {
		bit  Protocol
		name string
	}{
		{TTHeader, "TTHeader"},
		{Framed, "Framed"},
		{HTTP, "HTTP"},
		{GRPC, "GRPC"},
		{HESSIAN2, "Hessian2"},
		{TTHeaderStreaming, "TTHeaderStreaming"},
		{GRPCStreaming, "GRPCStreaming"},
	}

	for _, f := range flagMap {
		if tp&f.bit != 0 {
			flags = append(flags, f.name)
		}
	}

	if len(flags) > 0 {
		return strings.Join(flags, "|")
	}

	return Unknown
}
