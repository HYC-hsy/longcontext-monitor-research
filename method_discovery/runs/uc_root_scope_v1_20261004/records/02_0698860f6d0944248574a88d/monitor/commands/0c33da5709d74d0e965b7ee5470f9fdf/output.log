type MenuItem struct {
	ChildMenu *Menu
	// Since: 2.1
	IsQuit      bool
	IsSeparator bool
	Label       string
	Action      func()
	// Since: 2.1
	Disabled bool
	// Since: 2.1
	Checked bool
	// Icon is an optional icon to display next to the label
	//
	// Since: 2.2
	Icon Resource
	// Shortcut is an optional keyboard shortcut for the menu item
	//
	// Since: 2.2
	Shortcut Shortcut
}

