func (p *connPool) Dump() map[string]interface{} {
	result := make(map[string]interface{})
	result["pool_size"] = p.size
	result["remote_service"] = p.remoteService
	result["short_conn_mode"] = p.connOpts.ShortConn
	
	connections := make(map[string]interface{})
	p.conns.Range(func(key, value interface{}) bool {
		addr := key.(string)
		trans := value.(*transports)
		
		connInfo := make(map[string]interface{})
		connInfo["capacity"] = trans.size
		connInfo["round_robin_index"] = atomic.LoadUint32(&trans.index)
		
		// Collect per-connection status
		connStatus := make([]map[string]interface{}, 0, trans.size)
		activeCount := 0
		for i := 0; i < int(trans.size); i++ {
			status := make(map[string]interface{})
			status["slot"] = i
			
			if trans.cliTransports[i] == nil {
				status["state"] = "empty"
			} else {
				if trans.cliTransports[i].(grpc.IsActive).IsActive() {
					status["state"] = "active"
					activeCount++
				} else {
					status["state"] = "inactive"
				}
