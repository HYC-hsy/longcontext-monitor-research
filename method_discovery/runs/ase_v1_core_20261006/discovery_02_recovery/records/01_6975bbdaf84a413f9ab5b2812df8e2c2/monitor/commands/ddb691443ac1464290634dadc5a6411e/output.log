// CloseCallbackRegister allows registering callbacks for stream close events
type CloseCallbackRegister interface {
	OnClose(callback func())
}
--
// GRPCStreamGetter provides access to the underlying gRPC stream
type GRPCStreamGetter interface {
	GetGRPCStream() interface{}
}
--
// EventHandler defines a hook for streaming-related events
type EventHandler interface {
	OnEvent(ctx context.Context, event stats.Event) error
}
