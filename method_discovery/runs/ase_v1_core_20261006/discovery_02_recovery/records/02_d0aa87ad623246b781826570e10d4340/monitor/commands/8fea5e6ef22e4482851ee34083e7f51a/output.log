type ThemeVariant uint

const (
	// VariantDark is the dark version of a theme
	//
	// Since: 2.5
	VariantDark ThemeVariant = iota
	
	// VariantLight is the light version of a theme
	//
	// Since: 2.5
	VariantLight
)

