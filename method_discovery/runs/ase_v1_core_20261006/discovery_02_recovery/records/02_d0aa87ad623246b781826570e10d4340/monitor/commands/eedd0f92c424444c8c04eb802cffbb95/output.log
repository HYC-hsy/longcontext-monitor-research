=== Container.RemoveAll ===
func (c *Container) RemoveAll() {
	c.Objects = nil
	c.layout()
}

// Visible returns true if the container is currently visible, false otherwise.

=== Container.Add nil-safe ===
func (c *Container) Add(add CanvasObject) {
	if add == nil {
		return
	}
	c.Objects = append(c.Objects, add)
	c.layout()
}

