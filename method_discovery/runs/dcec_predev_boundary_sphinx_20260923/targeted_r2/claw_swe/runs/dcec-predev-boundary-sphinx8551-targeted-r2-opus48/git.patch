+#!/usr/bin/env python3
+"""Reproduction script for :type: and :rtype: false ambiguous warnings issue."""
+
+import os
+import shutil
+import sys
+import tempfile
+from pathlib import Path
+
+# Add testbed to path
+sys.path.insert(0, '/testbed')
+
+from sphinx.application import Sphinx
+from sphinx.util.docutils import docutils_namespace
+
+
+def test_type_rtype_xref_resolution():
+    """Test that :type: and :rtype: resolve to current module without warnings."""
+    
+    # Create a temporary directory for the test
+    with tempfile.TemporaryDirectory() as tmpdir:
+        srcdir = Path(tmpdir) / 'source'
+        outdir = Path(tmpdir) / 'build'
+        srcdir.mkdir()
+        
+        # Create conf.py
+        conf_content = """
+project = 'Test'
+extensions = []
+"""
+        (srcdir / 'conf.py').write_text(conf_content)
+        
+        # Create index.rst with the test case from the issue
+        index_content = """
+.. py:class:: mod.A
+
+.. py:class:: mod.submod.A
+
+.. py:function:: f()
+
+   - :py:class:`mod.A`
+   - :py:class:`mod.submod.A`
+
+   :param mod.A a:
+   :param mod.submod.A b:
+   :rtype: mod.A
+   :rtype: mod.submod.A
+
+.. py:currentmodule:: mod
+
+.. py:function:: f()
+
+   - :py:class:`A`
+   - :py:class:`mod.A`
+   - :py:class:`mod.submod.A`
+
+   :param A a:
+   :param mod.A b:
+   :param mod.submod.A c:
+   :rtype: A
+   :rtype: mod.A
+   :rtype: mod.submod.A
+
+.. py:currentmodule:: mod.submod
+
+.. py:function:: f()
+
+   - :py:class:`A`
+   - :py:class:`mod.A`
+   - :py:class:`mod.submod.A`
+
+   :param A a:
+   :param mod.A b:
+   :param mod.submod.A c:
+   :rtype: A
+   :rtype: mod.A
+   :rtype: mod.submod.A
+"""
+        (srcdir / 'index.rst').write_text(index_content)
+        
+        # Build with Sphinx
+        with docutils_namespace():
+            app = Sphinx(
+                srcdir=str(srcdir),
+                confdir=str(srcdir),
+                outdir=str(outdir),
+                doctreedir=str(outdir / '.doctrees'),
+                buildername='html',
+                freshenv=True,
+                warningiserror=False,
+                verbosity=0,
+            )
+            
+            # Capture warnings
+            warnings = []
+            original_warning = app._warning
+            
+            def capture_warning(message, *args, **kwargs):
+                warnings.append(str(message))
+                return original_warning(message, *args, **kwargs)
+            
+            app._warning = capture_warning
+            
+            try:
+                app.build()
+            except Exception as e:
+                print(f"Build failed: {e}")
+                import traceback
+                traceback.print_exc()
+            
+            # Check for the specific warnings mentioned in the issue
+            print("\n=== WARNINGS CAPTURED ===")
+            ambiguous_warnings = [w for w in warnings if 'more than one target found' in w and "'A'" in w]
+            
+            for i, warning in enumerate(ambiguous_warnings, 1):
+                print(f"{i}. {warning}")
+            
+            print(f"\nTotal ambiguous warnings for 'A': {len(ambiguous_warnings)}")
+            print(f"Expected: 0 warnings")
+            print(f"Actual: {len(ambiguous_warnings)} warnings")
+            
+            if len(ambiguous_warnings) > 0:
+                print("\n❌ BUG CONFIRMED: False ambiguous warnings detected!")
+                return False
+            else:
+                print("\n✓ NO WARNINGS: Issue appears to be fixed!")
+                return True
+
+
+if __name__ == '__main__':
+    success = test_type_rtype_xref_resolution()
+    sys.exit(0 if success else 1)
