// WithUnaryRPCTimeout sets the RPC timeout for unary methods.
func WithUnaryRPCTimeout(d time.Duration) UnaryOption {
	return UnaryOption{
		F: func(o *UnaryOptions, di *utils.Slice) {
			rpcinfo.AsMutableRPCConfig(o.Configs).SetRPCTimeout(d)
			di.Push(fmt.Sprintf("WithUnaryRPCTimeout(%v)", d))
		},
	}
