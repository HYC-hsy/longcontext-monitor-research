package desktop

import "fyne.io/fyne/v2"

// App interface extends the standard App interface with desktop-specific functionality.
// This includes system tray integration and other desktop-specific features.
//
// Since: 2.2
type App interface {
	fyne.App

	// SetSystemTrayMenu sets the menu to be displayed when the system tray icon is clicked.
	// This allows the application to provide quick access to common functions from the system tray.
	//
	// Since: 2.2
	SetSystemTrayMenu(menu *fyne.Menu)

	// SetSystemTrayIcon sets the icon to be displayed in the system tray.
	// This icon represents the application when it is running in the background.
	//
	// Since: 2.2
	SetSystemTrayIcon(icon fyne.Resource)
}
