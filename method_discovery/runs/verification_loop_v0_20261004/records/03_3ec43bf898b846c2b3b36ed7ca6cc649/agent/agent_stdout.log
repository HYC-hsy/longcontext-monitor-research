const (
	PurePayload Protocol = 0

	TTHeader  Protocol = 2  // existing value, must not change
	Framed    Protocol = 4  // existing value, must not change
	HTTP      Protocol = 8  // existing value, must not change
	GRPC      Protocol = 16 // existing value, must not change
	HESSIAN2  Protocol = 32 // existing value, must not change
	STREAMING Protocol = 32 // deprecated alias, kept for compatibility

	TTHeaderStreaming Protocol = 64  // new dedicated flag for TTHeader streaming
	GRPCStreaming     Protocol = 128 // new dedicated flag for gRPC streaming

	// Composite protocols (commonly used combinations)
	TTHeaderFramed = TTHeader | Framed
)

// DefaultProtocol is the default transport protocol.
const DefaultProtocol = Framed

// Unknown indicates the protocol is unknown.
