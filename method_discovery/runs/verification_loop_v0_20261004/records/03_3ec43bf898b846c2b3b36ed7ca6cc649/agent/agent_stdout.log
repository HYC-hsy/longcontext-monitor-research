+	TTHeader  Protocol = 2  // existing value, must not change
+	Framed    Protocol = 4  // existing value, must not change
+	HTTP      Protocol = 8  // existing value, must not change
+	GRPC      Protocol = 16 // existing value, must not change
+	HESSIAN2  Protocol = 32 // existing value, must not change
+	STREAMING Protocol = 32 // deprecated alias, kept for compatibility
 
-	TTHeaderFramed    = TTHeader | Framed
-	TTHeaderStreaming = TTHeader | STREAMING
+	TTHeaderStreaming Protocol = 64  // new dedicated flag for TTHeader streaming
+	GRPCStreaming     Protocol = 128 // new dedicated flag for gRPC streaming
+
+	// Composite protocols (commonly used combinations)
+	TTHeaderFramed = TTHeader | Framed
 )
 
+// DefaultProtocol is the default transport protocol.
+const DefaultProtocol = Framed
+
 // Unknown indicates the protocol is unknown.
 const Unknown = "Unknown"
 
 // String prints human readable information.
+// For composite protocols, it returns pipe-separated flag names in ascending bit order.
 func (tp Protocol) String() string {
-	switch tp {
-	case PurePayload:
+	// Handle zero value
+	if tp == PurePayload {
 		return "PurePayload"
-	case TTHeader:
-		return "TTHeader"
-	case Framed:
-		return "Framed"
-	case HTTP:
-		return "HTTP"
-	case TTHeaderFramed:
-		return "TTHeaderFramed"
-	case GRPC:
-		return "GRPC"
-	case HESSIAN2:
-		return "Hessian2"
-	case TTHeaderStreaming:
-		return "TTHeaderStreaming"
 	}
-	return Unknown
+
+	// Define known protocol flags in ascending bit order
+	type protocolFlag struct {
+		value Protocol
+		name  string
+	}
+	flags := []protocolFlag{
+		{TTHeader, "TTHeader"},
+		{Framed, "Framed"},
+		{HTTP, "HTTP"},
+		{GRPC, "GRPC"},
+		{HESSIAN2, "Hessian2"},
+		{STREAMING, "STREAMING"},
+		{TTHeaderStreaming, "TTHeaderStreaming"},
+		{GRPCStreaming, "GRPCStreaming"},
+	}
+
+	// Build composite name by checking each flag
+	var parts []string
+	for _, flag := range flags {
+		if tp&flag.value != 0 {
+			parts = append(parts, flag.name)
+		}
+	}
+
+	if len(parts) == 0 {
+		return Unknown
+	}
+	
+	// Join with pipe separator
+	result := parts[0]
+	for i := 1; i < len(parts); i++ {
+		result += "|" + parts[i]
+	}
+	return result
