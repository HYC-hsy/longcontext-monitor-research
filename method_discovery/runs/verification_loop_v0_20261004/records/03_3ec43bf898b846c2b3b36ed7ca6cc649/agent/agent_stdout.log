 * See the License for the specific language governing permissions and
 * limitations under the License.
 */

// Package transport provides predefined transport protocol.
package transport

// Protocol indicates the transport protocol.
type Protocol int

// Predefined transport protocols.
// Each protocol flag is a power of 2 to allow bitwise composition.
const (
	PurePayload Protocol = 0

	TTHeader  Protocol = 1  // 2^0
	Framed    Protocol = 2  // 2^1
	HTTP      Protocol = 4  // 2^2
	GRPC      Protocol = 8  // 2^3
	HESSIAN2  Protocol = 16 // 2^4
	STREAMING Protocol = 32 // 2^5 (deprecated for composites, kept for compatibility)

	TTHeaderStreaming Protocol = 64  // 2^6 - dedicated flag for TTHeader streaming
	GRPCStreaming     Protocol = 128 // 2^7 - dedicated flag for gRPC streaming

	// Composite protocols (commonly used combinations)
	TTHeaderFramed = TTHeader | Framed
)

// DefaultProtocol is the default transport protocol.
const DefaultProtocol = Framed

// Unknown indicates the protocol is unknown.
const Unknown = "Unknown"

// String prints human readable information.
// For composite protocols, it returns pipe-separated flag names in ascending bit order.
func (tp Protocol) String() string {
	// Handle zero value
	if tp == PurePayload {
		return "PurePayload"
	}

	// Define known protocol flags in ascending bit order
	type protocolFlag struct {
		value Protocol
		name  string
	}
	flags := []protocolFlag{
		{TTHeader, "TTHeader"},
		{Framed, "Framed"},
		{HTTP, "HTTP"},
		{GRPC, "GRPC"},
		{HESSIAN2, "Hessian2"},
		{STREAMING, "STREAMING"},
		{TTHeaderStreaming, "TTHeaderStreaming"},
		{GRPCStreaming, "GRPCStreaming"},
	}

	// Build composite name by checking each flag
	var parts []string
	for _, flag := range flags {
		if tp&flag.value != 0 {
			parts = append(parts, flag.name)
		}
	}

	if len(parts) == 0 {
		return Unknown
	}
	
	// Join with pipe separator
	result := parts[0]
	for i := 1; i < len(parts); i++ {
		result += "|" + parts[i]
	}
	return result
}
