=== Current String() implementation ===
func (tp Protocol) String() string {
	switch tp {
	case Framed:
		return "Framed"
	case TTHeader:
		return "TTHeader"
	case PurePayload:
		return "PurePayload"
	case HTTP:
		return "HTTP"
	case TTHeaderFramed:
		return "TTHeaderFramed"
	case GRPC:
		return "GRPC"
	case HESSIAN2:
		return "Hessian2"
	case TTHeaderStreaming:
		return "TTHeaderStreaming"
	case GRPCStreaming:
		return "GRPCStreaming"
	}
	return Unknown
}

=== Testing TTHeaderFramed ===
TTHeaderFramed is defined as: TTHeader | Framed
	TTHeaderFramed = TTHeader | Framed
