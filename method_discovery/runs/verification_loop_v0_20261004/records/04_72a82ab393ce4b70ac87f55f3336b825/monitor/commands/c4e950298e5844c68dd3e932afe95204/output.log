=== Target 3: String() method for composites ===
func (tp Protocol) String() string {
	switch tp {
	case Framed:
		return "Framed"
	case TTHeader:
		return "TTHeader"
	case PurePayload:
		return "PurePayload"
	case HTTP:
		return "HTTP"
	case GRPC:
		return "GRPC"
	case HESSIAN2:
		return "Hessian2"
	case TTHeaderStreaming:
		return "TTHeaderStreaming"
	case GRPCStreaming:
		return "GRPCStreaming"
	}
	
	// For composite values: enumerate all set flags in ascending order of bit values
	var parts []string
	if tp&PurePayload != 0 {
		parts = append(parts, "PurePayload")
	}
	if tp&TTHeader != 0 {
		parts = append(parts, "TTHeader")
	}
	if tp&Framed != 0 {
		parts = append(parts, "Framed")
	}
	if tp&HTTP != 0 {
		parts = append(parts, "HTTP")
	}
	if tp&GRPC != 0 {
		parts = append(parts, "GRPC")
	}
	if tp&HESSIAN2 != 0 {
		parts = append(parts, "Hessian2")
	}
	if tp&TTHeaderStreaming != 0 {
		parts = append(parts, "TTHeaderStreaming")
	}
	if tp&GRPCStreaming != 0 {
		parts = append(parts, "GRPCStreaming")
	}
	
	if len(parts) > 0 {
		return strings.Join(parts, "|")
	}
	return Unknown

