=== TARGET 3: String() method verification ===
Requirement: Composite protocols should show pipe-separated flags in ascending bit order
Example: TTHeaderFramed should return 'TTHeader|Framed'

Current String() implementation:
func (tp Protocol) String() string {
	switch tp {
	case Framed:
		return "Framed"
	case TTHeader:
		return "TTHeader"
	case PurePayload:
		return "PurePayload"
	case HTTP:
		return "HTTP"
	case TTHeaderFramed:
		return "TTHeaderFramed"
	case GRPC:
		return "GRPC"
	case HESSIAN2:
		return "Hessian2"
	case TTHeaderStreaming:
		return "TTHeaderStreaming"
	case GRPCStreaming:
		return "GRPCStreaming"
	}
	return Unknown
}

