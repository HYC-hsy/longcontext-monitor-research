type MenuItem struct {
	ChildMenu *Menu
	// Since: 2.1
	IsQuit      bool
	IsSeparator bool
	Label       string
	Action      func()
	// Since: 2.1
	Disabled bool
	// Since: 2.1
	Checked bool
	// Icon is the optional icon to display alongside the menu item label.
	Icon Resource
	// Shortcut is the optional keyboard shortcut associated with the menu item.
	Shortcut Shortcut
}
