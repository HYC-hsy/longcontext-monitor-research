
const (
	multiLineRows            = 3
	doubleClickWordSeperator = "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?"
)
--
	validationError     error

	// Rows specifies the exact number of text rows to display in a multi-line entry.
	// If set to 0, the entry will be sized based on its content (up to MinRows).
	// Since: 2.2
	Rows int

	// MinRows specifies the minimum number of text rows for a multi-line entry.
	// This is used when Rows is 0 to ensure a minimum visible height.
	// Since: 2.2
	MinRows int

	CursorRow, CursorColumn int
--
