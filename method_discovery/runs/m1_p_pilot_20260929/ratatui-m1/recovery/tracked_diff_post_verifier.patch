+// Stylize trait implementations
+use crate::style::Stylize;
+
+impl<'a> Stylize for Span<'a> {
+    fn style(&self) -> Style {
+        self.style
+    }
+
+    fn set_style(mut self, style: Style) -> Self {
+        self.style = style;
+        self
+    }
+}
+
+impl<'a> Stylize for Line<'a> {
+    fn style(&self) -> Style {
+        Style::default()
+    }
+
+    fn set_style(mut self, style: Style) -> Self {
+        self.spans = self
+            .spans
+            .into_iter()
+            .map(|span| span.set_style(style))
+            .collect();
+        self
+    }
+}
+
+impl<'a> Stylize for Text<'a> {
+    fn style(&self) -> Style {
+        Style::default()
+    }
+
+    fn set_style(mut self, style: Style) -> Self {
+        self.lines = self
+            .lines
+            .into_iter()
+            .map(|line| line.set_style(style))
+            .collect();
+        self
+    }
+}
