        "GA_MONITOR_ADVICE_REVISION": "0",
        "GA_MONITOR_FEEDBACK_FOCUS": "0",
        "GA_MONITOR_INQUIRY": "0",
        "GA_MONITOR_TOOL_FEEDBACK": "0",
        "GA_MONITOR_ACTIVE_WORKING_CONTEXT": "0",
        "GA_MONITOR_LIVE_AWARENESS": "0",
