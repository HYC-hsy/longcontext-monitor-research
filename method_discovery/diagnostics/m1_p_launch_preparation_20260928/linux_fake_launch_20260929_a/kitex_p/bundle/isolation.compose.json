      "image": "sha256:7ffcd70e49d77031b8e67eaa99226dc8468fa046f33e615118e8922b89fff32e",
      "read_only": true,
      "working_dir": "/logs",
      "entrypoint": [
        "/opt/m4-runtime/python/cpython-3.12.12-linux-x86_64-gnu/bin/python3.12",
        "/checks/container_entry.py"
      ]
    },
    "model-gateway": {
