@@ -54,6 +126,81 @@ class SingleStepTrial(Trial):
         if mode == VerifierEnvironmentMode.SHARED:
             await self._stop_agent_environment()
 
+    async def _run_agent_until_verified(
+        self, mode: VerifierEnvironmentMode
+    ) -> None:
+        if mode != VerifierEnvironmentMode.SHARED:
+            raise ValueError(
+                "continue_until_timeout currently requires shared verifier mode"
+            )
+        if self._agent_timeout_sec is None:
+            raise ValueError(
+                "continue_until_timeout requires agent.timeout_sec"
+            )
+
+        deadline = time.monotonic() + self._agent_timeout_sec
+        base_instruction = self.task.instruction
+        instruction = base_instruction
+        phase = 0
+        accumulated = None
+        interim_rewards = []
+
+        while (remaining := deadline - time.monotonic()) > 0:
+            phase_result = StepResult(step_name=f"continuation-{phase}")
+            try:
+                await self._run_agent_phase(
+                    target=phase_result,
+                    instruction=instruction,
+                    timeout_sec=remaining,
+                    user=self.task.config.agent.user,
+                )
+            except (AgentTimeoutError, NonZeroAgentExitCodeError) as exc:
+                self._record_exception(exc)
+                break
+
+            accumulated = _merge_agent_contexts(
+                accumulated, phase_result.agent_result
+            )
+            self.result.agent_result = accumulated
+
+            try:
+                interim = await self._run_shared_verifier(
+                    timeout_sec=self._verifier_timeout_sec,
+                    user=self.task.config.verifier.user,
+                )
+            finally:
+                await self.agent_environment.reset_dirs(
+                    remove_dirs=[self.agent_env_paths.tests_dir],
+                    create_dirs=[],
+                )
+
+            interim_rewards.append(dict(interim.rewards or {}))
+            if _verifier_passed(interim):
+                break
+
+            phase += 1
+            remaining = max(0, int(deadline - time.monotonic()))
+            instruction = _continuation_instruction(
+                base_instruction,
+                phase=phase,
+                remaining_sec=remaining,
+                rewards=interim.rewards,
+            )
+
+        if accumulated is None:
+            accumulated = AgentContext()
+        metadata = dict(accumulated.metadata or {})
+        metadata.update(
+            {
+                "continue_until_timeout": True,
+                "continue_until_timeout_phases": phase + 1,
+                "interim_verifier_rewards": interim_rewards,
+            }
+        )
+        accumulated.metadata = metadata
+        self.result.agent_result = accumulated
+        await self._sync_agent_output(self.result)
+
     @override
     async def _recover_outputs(self) -> None:
         await self._sync_agent_output(self.result)
