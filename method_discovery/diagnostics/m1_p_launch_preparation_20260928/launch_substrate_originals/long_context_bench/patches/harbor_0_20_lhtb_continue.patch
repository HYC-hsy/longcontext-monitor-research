 from harbor.trial.trial import Trial
 
 
+def _merge_agent_contexts(
+    accumulated: AgentContext | None, phase: AgentContext | None
+) -> AgentContext | None:
+    if phase is None:
+        return accumulated
+    if accumulated is None:
+        return phase.model_copy(deep=True)
+
+    def add_optional(left, right):
+        if left is None and right is None:
+            return None
+        return (left or 0) + (right or 0)
+
+    metadata = dict(accumulated.metadata or {})
+    metadata.update(phase.metadata or {})
+    return AgentContext(
+        n_input_tokens=add_optional(
+            accumulated.n_input_tokens, phase.n_input_tokens
+        ),
+        n_cache_tokens=add_optional(
+            accumulated.n_cache_tokens, phase.n_cache_tokens
+        ),
+        n_output_tokens=add_optional(
+            accumulated.n_output_tokens, phase.n_output_tokens
+        ),
+        cost_usd=add_optional(accumulated.cost_usd, phase.cost_usd),
+        rollout_details=[
+            *(accumulated.rollout_details or []),
+            *(phase.rollout_details or []),
+        ]
+        or None,
+        metadata=metadata or None,
+    )
+
+
+def _verifier_passed(result) -> bool:
+    if result is None or not result.rewards:
+        return False
+    try:
+        return float(result.rewards.get("reward", 0)) >= 1.0
+    except (TypeError, ValueError):
+        return False
+
+
+def _continuation_instruction(
+    base_instruction: str,
+    *,
+    phase: int,
+    remaining_sec: int,
+    rewards: dict | None,
+) -> str:
+    reward_text = ", ".join(
+        f"{key}={value}" for key, value in sorted((rewards or {}).items())
+    )
+    if not reward_text:
+        reward_text = "no numeric reward was produced"
+    return (
+        f"{base_instruction.rstrip()}\n\n"
+        "---\n"
+        "## INTERIM VERIFICATION DID NOT PASS\n\n"
+        f"Phase {phase} completed with {remaining_sec} seconds remaining. "
+        "Continue working in the same session and workspace. Do not stop until "
+        "the verifier passes or the trial timeout is reached.\n\n"
+        f"Interim verifier result: {reward_text}\n"
+    )
+
+
