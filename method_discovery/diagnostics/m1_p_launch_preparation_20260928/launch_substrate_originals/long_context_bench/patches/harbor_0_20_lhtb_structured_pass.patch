+    async def _structured_verifier_passed(self) -> bool:
+        """Honor a task-owned pass signal when its reward is continuous."""
+        result = await self.agent_environment.exec(
+            "cat /app/output/verification_result.json 2>/dev/null || true",
+            timeout_sec=30,
+        )
+        stdout = result.stdout or ""
+        if result.return_code or not stdout.strip():
+            return False
+        try:
+            payload = json.loads(stdout)
+        except (TypeError, json.JSONDecodeError):
+            return False
+        # This file is task output produced by the native verifier. It is not a
+        # benchmark-wide threshold and does not reinterpret partial rewards.
+        return payload.get("passed") is True
+
     @override
     async def _recover_outputs(self) -> None:
         await self._sync_agent_output(self.result)
