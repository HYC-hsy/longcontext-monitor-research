{
  "schema_version": "r0-real-task-protocol/2",
  "principle": "Complete real GenericAgent tasks own method selection; offline events and static representations are engineering or diagnostic evidence only.",
  "stage_gates": {
    "R1-Real-A": [
      "B0_unmodified_genericagent_baseline",
      "B1_direct_persistent_monitor",
      "4_paired_dev_pilot_tasks_from_at_least_3_sources",
      "complete_real_task_execution",
      "post_termination_native_evaluation"
    ],
    "R2-R3": [
      "incremental_mechanism_switch_against_previous_real_condition",
      "same_frozen_real_task_panel",
      "task_outcome_and_process_behavior",
      "offline_results_have_no_selection_authority"
    ],
    "R4-R5": [
      "all_16_dev_pilot_real_tasks",
      "at_least_2_independent_branches_per_selected_task"
    ],
    "R6-R7": [
      "12_task_validation_gate",
      "equal_visible_token_and_call_budget",
      "post_termination_native_evaluation"
    ],
    "Stage7": [
      "method_frozen",
      "30_task_confirmatory_final_holdout",
      "3_independent_branches_per_final_task",
      "report_all_120_with_split_stratification",
      "no_method_selection_on_final_results"
    ]
  },
  "preflight": [
    "api_model",
    "task_image_or_environment",
    "disk_budget",
    "public_tools",
    "native_evaluator_post_termination",
    "trace_and_telemetry_sink"
  ],
  "evidence_authority": {
    "E0": "unit_schema_interface_tests_only",
    "E1": "offline_packets_replays_llm_judges_and_case_analysis_only",
    "E2": "method_dev_complete_real_genericagent_runs_select_methods",
    "E3": "stage_validation_then_post_freeze_final_holdout"
  },
  "stopping_rule": "Stop after first paired real baseline result, first real mechanism gain or regression, cost anomaly, or process/native-evaluator disagreement.",
  "selection_rule": "Keep a bounded candidate beam supported by complete real-task behavior; offline accuracy cannot promote or eliminate a core mechanism."
}
