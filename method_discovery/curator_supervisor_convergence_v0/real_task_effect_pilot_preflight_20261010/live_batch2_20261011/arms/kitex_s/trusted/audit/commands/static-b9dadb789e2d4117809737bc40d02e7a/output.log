=== Current Protocol String() implementation (still wrong - just switch cases) ===
func (tp Protocol) String() string {
	switch tp {
	case PurePayload:
		return "PurePayload"
	case TTHeader:
		return "TTHeader"
	case Framed:
		return "Framed"
	case HTTP:
		return "HTTP"
	case TTHeaderFramed:
		return "TTHeaderFramed"
	case GRPC:
		return "GRPC"
	case HESSIAN2:
		return "Hessian2"
	case TTHeaderStreaming:
		return "TTHeaderStreaming"
	case GRPCStreaming:
		return "GRPCStreaming"
	}
	return Unknown
}
