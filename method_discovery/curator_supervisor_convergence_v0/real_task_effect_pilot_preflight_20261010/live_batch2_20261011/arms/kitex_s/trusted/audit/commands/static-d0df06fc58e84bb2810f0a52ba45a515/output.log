import (
	"time"

	"github.com/cloudwego/kitex/client"
)

// WithRecvTimeout sets the receive timeout for streaming calls.
// This timeout applies to individual stream receive operations.
func WithRecvTimeout(d time.Duration) client.Option {
	return client.Option{
		F: func(o *client.Options, di *client.DebugInfo) {
			o.StreamX.RecvTimeout = d
		},
	}
}
