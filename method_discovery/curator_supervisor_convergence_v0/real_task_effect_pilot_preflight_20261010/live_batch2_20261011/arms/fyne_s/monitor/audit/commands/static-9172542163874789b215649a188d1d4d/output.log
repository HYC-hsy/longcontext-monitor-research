=== Target 1: AppMetadata struct ===
type AppMetadata struct {
	// ID is the unique application identifier (e.g., "com.example.myapp")
	ID string
	// Name is the human-friendly application name (e.g., "My App")
	Name string
	// Version is the semantic version string (e.g., "1.0.0")
	Version string
	// Build is the build number
	Build int
	// Icon is the application icon resource
	Icon Resource

