+	}
+	defsF svgFunc = func(c *IconCursor, attrs []xml.Attr) error {
+		c.inDefs = true
+		return nil
+	}
+	linearGradientF svgFunc = func(c *IconCursor, attrs []xml.Attr) error {
+		var err error
+		c.inGrad = true
