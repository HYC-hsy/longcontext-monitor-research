+}
+
+func (p *parseContext) SetBlockOffset(v int) {
+	p.blockOffset = v
+}
+
+func (p *parseContext) BlockIndent() int {
+	return p.blockIndent
+}
+
+func (p *parseContext) SetBlockIndent(v int) {
+	p.blockIndent = v
