+
+func (m *markdown) Renderer() renderer.Renderer {
+	return m.renderer
+}
+
+func (m *markdown) SetRenderer(v renderer.Renderer) {
+	m.renderer = v
+}
+
+// An Extender interface is used for extending Markdown.
+type Extender interface {
+	// Extend extends the Markdown.
+	Extend(Markdown)
+}
