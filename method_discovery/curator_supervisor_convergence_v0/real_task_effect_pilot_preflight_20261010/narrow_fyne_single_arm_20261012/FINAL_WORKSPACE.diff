+// NewParser returns a new Parser with given options.
+func NewParser(options ...Option) Parser {
+	config := NewConfig()
+	for _, opt := range options {
+		opt.SetParserOption(config)
+	}
+
+	p := &parser{
+		options: map[OptionName]interface{}{},
+		config:  config,
+	}
+
+	return p
+}
