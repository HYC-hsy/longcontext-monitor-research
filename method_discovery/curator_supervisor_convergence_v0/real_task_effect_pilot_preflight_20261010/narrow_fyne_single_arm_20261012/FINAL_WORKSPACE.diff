+		sgm.Line(c)
+		return
+	}
+	sgm.joinF()
+	QuadTo(float32(r.a.X), float32(r.a.Y), // Pts are x64, but does not matter.
+		float32(b.X), float32(b.Y),
+		float32(c.X), float32(c.Y),
+		func(dx, dy float32) {
+			sgm.lineF(fixed.Point26_6{X: fixed.Int26_6(dx), Y: fixed.Int26_6(dy)})
+		})
