+func QuadTo(ax, ay, bx, by, cx, cy float32, LineTo func(dx, dy float32)) {
+	devsq := devSquared(ax, ay, bx, by, cx, cy)
+	if devsq >= 0.333 {
+		const tol = 3
+		n := 1 + int(math.Sqrt(math.Sqrt(tol*float64(devsq))))
+		t, nInv := float32(0), 1/float32(n)
+		for i := 0; i < n-1; i++ {
+			t += nInv
+
+			mt := 1 - t
+			t1 := mt * mt
+			t2 := mt * t * 2
+			t3 := t * t
+			LineTo(
