+					return errors.New(errStr)
+				} else if c.ErrorMode == WarnErrorMode {
+					log.Println(errStr)
+				}
+				return nil
+			}
+			if err := df(c, def.Attrs); err != nil {
+				return err
+			}
+			if def.Tag != "g" {
+				// pop style
+				c.StyleStack = c.StyleStack[:len(c.StyleStack)-1]
+			}
+		}
+		return nil
+	}
+)
