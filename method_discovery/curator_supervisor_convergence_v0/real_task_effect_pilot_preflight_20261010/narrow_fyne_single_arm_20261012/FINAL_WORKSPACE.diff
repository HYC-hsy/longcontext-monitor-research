+
+// TrimLeftSpace returns a new segment by slicing off all leading
+// space characters including padding.
+func (t *Segment) TrimLeftSpace(buffer []byte) Segment {
+	v := buffer[t.Start:t.Stop]
+	l := util.TrimLeftSpaceLength(v)
