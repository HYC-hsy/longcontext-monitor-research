+// DotProd returns the inner product of p and q
+func DotProd(p fixed.Point26_6, q fixed.Point26_6) fixed.Int52_12 {
+	return fixed.Int52_12(int64(p.X)*int64(q.X) + int64(p.Y)*int64(q.Y))
