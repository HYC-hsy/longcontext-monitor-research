+// space characters.
+func (t *Segment) TrimRightSpace(buffer []byte) Segment {
+	v := buffer[t.Start:t.Stop]
+	l := util.TrimRightSpaceLength(v)
+	if l == len(v) {
+		return NewSegment(t.Start, t.Start)
+	}
+	return NewSegmentPadding(t.Start, t.Stop-l, t.Padding)
