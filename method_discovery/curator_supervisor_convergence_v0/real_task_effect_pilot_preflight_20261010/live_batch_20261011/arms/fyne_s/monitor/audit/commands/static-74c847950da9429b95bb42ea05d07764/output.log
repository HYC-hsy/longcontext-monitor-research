	if colorsRaw, ok := raw["colors"].(map[string]interface{}); ok {
		for name, value := range colorsRaw {
			if hexStr, ok := value.(string); ok {
				c, err := parseHexColor(hexStr)
				if err != nil {
					return nil, fmt.Errorf("invalid color for %s: %w", name, err)
				}
				theme.colors[fyne.ThemeColorName(name)] = c
			}
		}
	}
	
