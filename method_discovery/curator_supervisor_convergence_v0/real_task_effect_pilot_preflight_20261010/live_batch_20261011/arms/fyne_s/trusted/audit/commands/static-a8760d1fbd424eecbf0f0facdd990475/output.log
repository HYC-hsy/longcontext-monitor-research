=== 1. Set() method - should implement Sscanf parsing ===
func (s *sprintfBinding) Set(str string) error {
	s.mu.Lock()
	defer s.mu.Unlock()

	// Create scan targets for each source type
	targets := make([]interface{}, len(s.sources))
	for i, source := range s.sources {
		switch source.(type) {
		case Bool:
			var v bool
			targets[i] = &v
		case Float:
			var v float64
			targets[i] = &v
		case Int:
			var v int
			targets[i] = &v
		case Rune:
			var v rune
			targets[i] = &v
		case String:
			var v string
			targets[i] = &v
		case URI:
			var v string
			targets[i] = &v
		case Untyped:
			// Bytes cannot round-trip
			return fmt.Errorf("sprintf binding with Bytes/Untyped cannot be set (no round-trip support)")
		default:
			return fmt.Errorf("unsupported source type for Set: %T", source)
