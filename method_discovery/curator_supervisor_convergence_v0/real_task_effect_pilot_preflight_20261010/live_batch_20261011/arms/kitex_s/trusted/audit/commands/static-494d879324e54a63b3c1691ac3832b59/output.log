    41	func encodeGenericThrift(out bufiox.Writer, ctx context.Context, method string, msgType remote.MessageType, seqID int32, msg generic.ThriftWriter) error {
    42		binaryWriter := thrift.NewBufferWriter(out)
    43		if err := binaryWriter.WriteMessageBegin(method, thrift.TMessageType(msgType), seqID); err != nil {
    44			return perrors.NewProtocolErrorWithErrMsg(err, fmt.Sprintf("thrift marshal, Write failed: %s", err.Error()))
    45		}
    46		binaryWriter.Recycle()
    47		if err := msg.Write(ctx, method, out); err != nil {
    48			return perrors.NewProtocolErrorWithErrMsg(err, fmt.Sprintf("thrift marshal, Write failed: %s", err.Error()))
    49		}
    50		return nil
    51	}
