--- a/menu.go
+++ b/menu.go
@@ -12,6 +12,28 @@ func NewMenu(label string, items ...*MenuItem) *Menu {
 	return &Menu{Label: label, Items: items}
 }
 
+// Refresh triggers a redraw of this menu in all windows where it is currently displayed.
+// This should be called when menu items, icons, shortcuts, or other properties have been updated.
+//
+// Since: 2.5
+func (m *Menu) Refresh() {
+	app := CurrentApp()
+	if app == nil {
+		return
+	}
+
+	for _, win := range app.Driver().AllWindows() {
+		if win.MainMenu() != nil {
+			for _, menu := range win.MainMenu().Items {
+				if menu == m {
+					win.SetMainMenu(win.MainMenu())
+					break
+				}
+			}
+		}
+	}
+}
+
 // MenuItem is a single item within any menu, it contains a display Label and Action function that is called when tapped.
 type MenuItem struct {
 	ChildMenu *Menu
@@ -24,6 +46,14 @@ type MenuItem struct {
 	Disabled bool
 	// Since: 2.1
 	Checked bool
+	// Icon is an optional icon to display alongside the menu item label.
+	//
+	// Since: 2.5
+	Icon Resource
+	// Shortcut is an optional keyboard shortcut associated with this menu item.
+	//
+	// Since: 2.5
+	Shortcut Shortcut
 }
 
 // NewMenuItem creates a new menu item from the passed label and action parameters.
@@ -46,3 +76,20 @@ type MainMenu struct {
 func NewMainMenu(items ...*Menu) *MainMenu {
 	return &MainMenu{items}
 }
+
+// Refresh triggers a redraw of this main menu in all windows where it is currently set.
+// This should be called when the menu structure or menu items have been updated.
+//
+// Since: 2.5
+func (m *MainMenu) Refresh() {
+	app := CurrentApp()
+	if app == nil {
+		return
+	}
+
+	for _, win := range app.Driver().AllWindows() {
+		if win.MainMenu() == m {
+			win.SetMainMenu(m)
+		}
+	}
+}
