From: HYC-hsy <3510069313@qq.com>
Date: Wed, 14 Oct 2026 20:58:43 +0800
Subject: [PATCH] Add reproducible hash index for source-memory audit artifacts

---
 .../audit_hashes.py                           | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)
 create mode 100644 method_discovery/curator_supervisor_convergence_v0/pma_full_upstream_ga_v1_20261013/audit_hashes.py

diff --git a/method_discovery/curator_supervisor_convergence_v0/pma_full_upstream_ga_v1_20261013/audit_hashes.py b/method_discovery/curator_supervisor_convergence_v0/pma_full_upstream_ga_v1_20261013/audit_hashes.py
new file mode 100644
index 00000000..082089cd
--- /dev/null
+++ b/method_discovery/curator_supervisor_convergence_v0/pma_full_upstream_ga_v1_20261013/audit_hashes.py
@@ -0,0 +1,21 @@
+"""Write reproducible SHA-256 index for fixed offline shadow artifacts."""
+import hashlib
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parent
+AUDIT = ROOT / "source_memory_audit_20261014"
+TARGETS = [ROOT / "source_screen_fake_final_20261014",
+           ROOT / "source_screen_request_examples_20261014",
+           AUDIT / "SHADOW_RAW.tar.gz", AUDIT / "AUDIT.txt",
+           ROOT / "SOURCE_MEMORY_STATIC_SCREEN_DRAFT.json",
+           ROOT / "source_memory.py", ROOT / "source_agent.py",
+           *sorted(AUDIT.glob("*.patch"))]
+rows = []
+for target in TARGETS:
+    for path in ([target] if target.is_file() else sorted(target.rglob("*"))):
+        if path.is_file():
+            rows.append(f"{hashlib.sha256(path.read_bytes()).hexdigest()}  "
+                        f"{path.relative_to(ROOT).as_posix()}")
+(AUDIT / "HASHES.txt").write_text("\n".join(rows) + "\n", encoding="utf-8")
+print(f"indexed {len(rows)} files")
-- 
