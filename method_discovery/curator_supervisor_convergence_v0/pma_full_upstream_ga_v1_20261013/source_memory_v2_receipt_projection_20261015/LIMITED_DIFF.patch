+                bank = agent.memory
+                old_handle = bank.register_leaf("old", "task_instruction", inherited, 1,
+                                                "initial_user_content", "1" * 64)
+                old_id = bank.save_sourced("knowledge", marker, "task_requirement", [
+                    {"source_handle": old_handle, "start_line": 1, "end_line": 1}])
