+// SetMinRowsVisible sets the minimum number of rows that should be visible in the list.
+// This affects the minimum size calculation of the list widget.
+//
+// Since: 2.2
+func (l *List) SetMinRowsVisible(rows int) {
+	if rows < 1 {
+		rows = 1
+	}
+	l.itemMin = l.itemMin.Max(fyne.NewSize(l.itemMin.Width, float32(rows)*(l.itemMin.Height+theme.SeparatorThicknessSize())))
+	l.Refresh()
+}
