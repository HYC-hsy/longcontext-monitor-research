+// Refresh should be called to update the main menu if any of its items have changed.
+// This will cause all windows using this main menu to re-render with the updated state.
+//
+// Since: 2.2
+func (m *MainMenu) Refresh() {
+	wins := CurrentApp().Driver().AllWindows()
