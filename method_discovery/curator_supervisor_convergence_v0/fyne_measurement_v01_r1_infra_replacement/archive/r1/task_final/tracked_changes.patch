+// OpenDesktopSplash opens a splash window using the desktop driver.
+// This is a convenience function that gets the current driver, checks if it's a desktop driver,
+// and creates a splash window if supported.
+// Returns nil if the current driver doesn't support desktop features.
+//
+// Since: 2.2
+func OpenDesktopSplash(app fyne.App) fyne.Window {
+	if d, ok := app.Driver().(Driver); ok {
+		return d.CreateSplashWindow()
+	}
+	return nil
+}
