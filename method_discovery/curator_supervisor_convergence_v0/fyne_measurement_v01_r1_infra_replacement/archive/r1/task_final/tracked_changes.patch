+// Refresh should be called to update the menu if any of its items have changed.
+// This will cause all windows displaying this menu to re-render with the updated state.
+//
+// Since: 2.2
+func (m *Menu) Refresh() {
+	wins := CurrentApp().Driver().AllWindows()
+	for _, win := range wins {
+		if mainMenu := win.MainMenu(); mainMenu != nil {
+			mainMenu.Refresh()
+		}
+	}
+}
