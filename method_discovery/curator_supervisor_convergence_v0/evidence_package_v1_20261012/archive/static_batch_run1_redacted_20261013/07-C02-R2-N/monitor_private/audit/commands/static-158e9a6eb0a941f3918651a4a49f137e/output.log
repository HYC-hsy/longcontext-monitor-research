//   // greeting.Get() returns "Hello, Alice!"
//
// Since: 2.2
func StringToStringWithFormat(str String, format string) String {
	b := &stringToStringWithFormat{
		format: format,
		source: str,
	}

	// Listen to source changes
	str.AddListener(b)

	return b
}

// DataChanged is called when the source string changes.
