func (b *sprintfBinding) Set(str string) error {
	b.lock.Lock()
	defer b.lock.Unlock()

	// Create destination pointers for Sscanf based on source types
	values := make([]interface{}, len(b.sources))
	for i, source := range b.sources {
		switch source.(type) {
		case String:
			var s string
