+            for item in pma.requests[0]['tools']])
+        self.assertEqual(ep.memory.memory.status, '')
+        task_only = ep.manager.sentinel._compact_trajectory([{
+            'step': -1, 'action': None, 'observation': 'Clean mug.'}])
